# Model provider: local | minimax | mock
MODEL_PROVIDER=local

# Local OpenAI-compatible model endpoint, such as Ollama, vLLM, LM Studio, or LocalAI.
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen2.5
LOCAL_MODEL_API_KEY=

# Optional MiniMax fallback. Only used when MODEL_PROVIDER=minimax.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3
MINIMAX_BASE_URL=https://api.minimax.io

# Future real AWS provider settings. The mock provider ignores these.
AWS_ROLE_ARN=
AWS_REGION=us-east-1

# Service catalog source: mock | backstage | cmdb
SERVICE_CATALOG_SOURCE=mock
BACKSTAGE_CATALOG_URL=
CMDB_SERVICE_CATALOG_URL=
